# local/run.sh가 읽는 환경 파일. 복사해서 .env.local로 만들고 값을 채운다 (.env.local은 git 무시).
# 이름은 .github/workflows/scraper.yml 의 secrets 와 같다. 값에 공백이나 특수문자가 있으면 큰따옴표로 감싼다.
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_TO=
GEMINI_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 선택 (workflow_dispatch 입력과 실행 모드. 보통 비워 두고 필요할 때 run.sh 인자로 준다)
# TEST_BOARDS=
# BACKFILL_FROM=
# SKIP_MAIL=
# FORCE_REPROCESS=
