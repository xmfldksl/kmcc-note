<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xmfldksl.kmcc-note</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_DIR__/local/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>LANG</key>
    <string>ko_KR.UTF-8</string>
  </dict>

  <!-- 월-금 KST 10:30, 17:00 (2026-10-13 변경. 로컬 실행은 Actions 혼잡 회피 지터가 필요 없다.
       workflow cron은 아직 11:13, 16:13 기준이며 Actions 복구 시 맞출지 재결정한다).
       launchd의 Weekday는 범위를 받지 않아 요일별로 나눠 적는다 (1=월 ... 5=금).
       맥이 잠자기 중이었으면 깨어난 직후 밀린 예약이 1회 실행된다. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <!-- run.sh가 날짜별 로그(YYYY-MM-DD.log)를 직접 기록한다. 아래는 run.sh 시작 전 오류용. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kmcc-note/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kmcc-note/launchd.log</string>
</dict>
</plist>
